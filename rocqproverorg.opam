opam-version: "2.0"
synopsis: "Official Rocq Prover website"
description:
  "This repository contains the server that serves the official Rocq website at https://rocq-prover.org."
maintainer: ["Matthieu Sozeau" "Nicolas Tabareau" "Théo Zimmermann"]
authors: [
  "Thibaut Mattio"
  "Lucas Pluvinage"
  "Patrick Ferris"
  "Ashish Agarwal"
  "Kanishka Azimi"
  "Richard Davison"
  "Jiae Kam"
  "Bastien Sozeau"
  "Matthieu Sozeau"
  "Nicolas Tabareau"
  "Théo Zimmermann"
]
license: "ISC"
homepage: "https://github.com/rocq-prover/rocq-prover.org"
doc: "https://rocq-prover.org/"
bug-reports: "https://github.com/rocq-prover/rocq-prover.org/issues"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.15"}
  "ppx_deriving"
  "cohttp"
  "cohttp-lwt-unix"
  "bos"
  "crunch"
  "dream" {>= "1.0.0~alpha8"}
  "dream-accept"
  "dream-encoding"
  "graphql" {>= "0.14.0"}
  "fpath"
  "fmt"
  "logs"
  "cmarkit" {>= "0.2.0"}
  "opam-format"
  "timedesc" {>= "2.0.0"}
  "yojson"
  "lwt"
  "hilite" {>= "0.5.0"}
  "river" {>= "0.6"}
  "syndic"
  "alcotest" {with-test}
  "mdx" {with-test & >= "1.10.0"}
  "ppx_deriving_yaml" {>= "0.4.0"}
  "ppx_stable"
  "ezjsonm"
  "ptime"
  "cmdliner" {>= "1.1.0"}
  "xmlm"
  "uri"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/rocq-prover/rocq-prover.org.git"
pin-depends: [
  # gluten fd-leak fix (mtelvers/gluten branch fix/io-loop-close-on-exn-0.5.2,
  # cherry-picked onto upstream 0.5.2), from ocaml.org#3831. Released
  # gluten-lwt-unix skips Lwt_unix.close when shutdown raises ENOTCONN on a
  # peer-reset socket, and its IO loop never closes the socket when a read/write
  # loop raises, so every client that disconnects mid-request leaks one fd.
  # Dream >= 1.0.0~alpha8 consumes gluten from opam rather than vendoring it,
  # which is why the dream dependency requires alpha8.
  [ "gluten.0.5.2" "git+https://github.com/mtelvers/gluten.git#8cbce6d903b3e779b1fc3f505ae8702d858ad3a2" ]
  [ "gluten-lwt.0.5.2" "git+https://github.com/mtelvers/gluten.git#8cbce6d903b3e779b1fc3f505ae8702d858ad3a2" ]
  [ "gluten-lwt-unix.0.5.2" "git+https://github.com/mtelvers/gluten.git#8cbce6d903b3e779b1fc3f505ae8702d858ad3a2" ]
]
